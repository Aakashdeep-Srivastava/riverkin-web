# RiverKin web — environment variables
# NOTE: NEXT_PUBLIC_* values are baked into the browser bundle at build time.
# Never put secrets (API keys, tokens) in NEXT_PUBLIC_* variables.

# Base URL of the RiverKin API (used at build time and by the fetch wrapper).
# Also used by `npm run gen:api` to fetch "$NEXT_PUBLIC_API_URL/openapi.json".
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: MapLibre style JSON URL (OSM-based). If unset, the map shows a placeholder.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Support / funding page (all optional; /support degrades gracefully) ---
# Full GitHub Sponsors URL (shown once you enrol at github.com/sponsors).
NEXT_PUBLIC_GITHUB_SPONSORS=
# A Razorpay hosted Payment Page / payment link for one-off contributions.
# Create it in the Razorpay dashboard (Payment Pages) and paste the URL here.
# Using a hosted link means no keys in the browser and no CSP changes.
NEXT_PUBLIC_DONATE_URL=
# Public repo URL (fallback + "contribute code" link on /support).
NEXT_PUBLIC_GITHUB_REPO=https://github.com/Aakashdeep-Srivastava/riverkin-web
# Contact address for organisational sponsorship enquiries.
NEXT_PUBLIC_SPONSOR_EMAIL=hello@riverkin.online
